{
  "name": "ai-import-assistant-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend + indexing worker for the AI Import Assistant logistics workspace",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker/index.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "migrate": "node dist/db/migrate.js",
    "migrate:folders": "tsx src/db/migrateFolderSkeleton.ts",
    "reminders:once": "tsx src/scripts/reminders-once.ts",
    "seed": "node dist/auth/seed.js",
    "smoke": "node scripts/smoke-test.mjs",
    "eval:grounding": "node scripts/eval-grounding.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@qdrant/js-client-rest": "^1.15.1",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.34.10",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "uuid": "^11.0.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
