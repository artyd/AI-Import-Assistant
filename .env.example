# Copy to .env and fill in. Used by docker-compose.yml.
# ------------------------------------------------------------------

# --- Secrets / providers (required) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxx          # Voyage AI key
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars

# --- Public domain ---
# The frontend and backend are served from ONE origin by the host's system Caddy
# (/etc/caddy/Caddyfile, outside this compose file — see DEPLOYMENT.md). Because
# the browser talks to the backend on the same origin as the app, CORS is mostly
# moot; still, config requires CORS_ORIGIN, so set it to that public origin.
CORS_ORIGIN=https://ai-import-assistant.duckdns.org

# --- Postgres (compose builds DATABASE_URL from these) ---
POSTGRES_USER=aia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aia

# --- Optional overrides (sensible defaults if omitted) ---
ANTHROPIC_MODEL=claude-opus-4-8
EMBEDDING_MODEL=voyage-3
JWT_EXPIRES_IN=12h
MAX_UPLOAD_BYTES=26214400

# ------------------------------------------------------------------
# NOTE: inside docker-compose these are derived automatically and do NOT need to
# be set here — they point at the compose service names:
#   DATABASE_URL = postgres://<user>:<pass>@postgres:5432/<db>
#   REDIS_URL    = redis://redis:6379
#   QDRANT_URL   = http://qdrant:6333
# If you run the backend/worker OUTSIDE compose, set those three explicitly.
# The backend also reads (all optional): QDRANT_API_KEY, STORAGE_DIR,
# CHAT_RATE_MAX, CHAT_RATE_WINDOW, EMBEDDING_PROVIDER (default: voyage).
