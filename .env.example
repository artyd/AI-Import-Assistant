# Copy to .env and fill in. Used by docker-compose.yml.
# ------------------------------------------------------------------

# --- Secrets / providers (required) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars

# Login: email + password (create users: node dist/auth/seed.js <email> <password> [name]).
# Optional quick PIN keypad — OFF unless both are set. PIN must be 6–8 digits;
# it logs in as ACCESS_CODE_EMAIL. Brute force is blocked (5 tries/IP/15 min and
# a global lockout after 20 wrong PINs/24 h — password login keeps working).
# ACCESS_CODE=482913
# ACCESS_CODE_EMAIL=you@example.com

# --- Public domain ---
# The frontend and backend are served from ONE origin by the host's system Caddy
# (/etc/caddy/Caddyfile, outside this compose file — see DEPLOYMENT.md). Because
# the browser talks to the backend on the same origin as the app, CORS is mostly
# moot; still, config requires CORS_ORIGIN, so set it to that public origin.
CORS_ORIGIN=https://ai-import-assistant.duckdns.org

# --- Postgres (compose builds DATABASE_URL from these) ---
POSTGRES_USER=aia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aia

# --- Optional overrides (sensible defaults if omitted) ---
ANTHROPIC_MODEL=claude-opus-4-8
# Ingest-time Markdown: Claude vision transcribes PDFs/scans/photos (tables →
# Markdown tables) in windows of N pages; set VISION=false to keep text-layer
# PDFs on the cheap local parser (vision then only for scans).
MARKDOWN_VISION_ENABLED=true
MARKDOWN_PDF_BATCH_PAGES=5
JWT_EXPIRES_IN=12h
MAX_UPLOAD_BYTES=26214400
# OCR fallback for scanned PDFs / images (Claude vision, worker-side).
OCR_ENABLED=true
OCR_MODEL=claude-sonnet-5-5

# News ingest (worker cron): fetch public RSS/Atom feeds into news_items and
# purge anything older than NEWS_RETENTION_DAYS. ON by default (the worker here
# has outbound network to the feeds). Set NEWS_ENABLED=false to disable.
NEWS_ENABLED=true
NEWS_CRON=*/30 * * * *
NEWS_RETENTION_DAYS=14

# Map / vessel tracking (Phase D). 'demo' interpolates a deterministic point along
# each shipment's route (no network); 'aishub' is a live AIS adapter that needs
# AIS_API_KEY. With 'aishub' but no key set, the map falls back to demo.
AIS_PROVIDER=demo                                     # demo | aishub
# AIS_API_KEY=xxxxxxxxxxxxxxxxxxxx                     # AISHub/AISStream key (if aishub)

# BYOK / AI settings (Phase E). Symmetric key that encrypts each user's provider
# API key at rest (AES-256-GCM). Must decode to EXACTLY 32 bytes — accepts base64
# or 64 hex chars. Leave empty to DISABLE BYOK: analysis stays on the built-in
# server-side Claude and PUT /api/ai-config { engine:'byok' } returns 400. BYOK is
# scoped to the consolidated-analysis AI step only; the main Штурман agent always
# uses ANTHROPIC_API_KEY. Generate one: `openssl rand -base64 32`.
# BYOK_ENC_KEY=

# logist-mcp integration. Base URL of the INTERNAL customs/logistics tool service
# (docker-compose `logist-mcp`, plain-REST) for UKTZED / dual-use / NBU rate /
# PubChem. Internal-only (compose network) — no host port, no Caddy. Compose sets
# it to the internal service by default; set empty to disable the agent tools.
# LOGIST_MCP_URL=http://logist-mcp:8015

# ------------------------------------------------------------------
# NOTE: inside docker-compose these are derived automatically and do NOT need to
# be set here — they point at the compose service names:
#   DATABASE_URL = postgres://<user>:<pass>@postgres:5432/<db>
#   REDIS_URL    = redis://redis:6379
# If you run the backend/worker OUTSIDE compose, set those two explicitly.
# The backend also reads (all optional): STORAGE_DIR, CHAT_RATE_MAX,
# CHAT_RATE_WINDOW, LIBREOFFICE_BIN (default: soffice).
